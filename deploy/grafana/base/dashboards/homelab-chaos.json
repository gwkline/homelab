      "title": "Kill and recovery events over time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Runs that ended without a deletion: kill switch off, no eligible targets, or no Ready candidate.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({namespace=\"sandbox\", workload=\"chaos-monkey\"} |~ \"(?i)kill switch|nothing to do|skipping run\" [7d]))",
          "refId": "A"
        }
      ],
      "title": "No-op runs (7d)",
      "type": "stat"
