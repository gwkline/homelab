{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "schedule": ["after 6am and before 10am every weekday"],
  "prConcurrentLimit": 4,
  "pinDigests": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins recorded next to a `renovate:` comment (ARG/ENV lines in Dockerfiles)",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s*(?:ARG|ENV) [A-Za-z0-9_]+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Agent CLIs: weekly, grouped, auto-merge patch/minor after CI passes",
      "groupName": "agent CLIs (codex/claude-code/opencode/t3)",
      "matchFileNames": [
        "apps/t3code/Dockerfile",
        "apps/factory/worker/Dockerfile"
      ],
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "schedule": ["after 6am and before 9am on monday"]
    },
    {
      "description": "Major bumps of agent CLIs: separate PR, no automerge \u2014 review breaking changes",
      "groupName": "agent CLI majors",
      "matchFileNames": [
        "apps/t3code/Dockerfile",
        "apps/factory/worker/Dockerfile"
      ],
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "t3 rides the nightly channel (issue #35): the pin is a recorded nightly version and Renovate bumps within the channel \u2014 never to a stable release",
      "matchDatasources": ["npm"],
      "matchDepNames": ["t3"],
      "allowedVersions": "/-nightly\\./"
    },
    {
      "description": "opencode-ai installed from the beta prefix in t3code: beta prereleases only, never dev builds",
      "matchDatasources": ["npm"],
      "matchDepNames": ["opencode-ai"],
      "matchCurrentVersion": "/^0\\.0\\.0-beta-/",
      "allowedVersions": "/^0\\.0\\.0-beta-/"
    },
    {
      "description": "Third-party base/runtime images: keep tag+digest pins current, automerge digest/pin once CI is green",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": [
        "^library/",
        "^restic/",
        "^gethomepage/",
        "^nousresearch/",
        "^victoriametrics/",
        "^registry\\.k8s\\.io/"
      ],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Downloaded build-time tools (kubectl, gh, scanners, semgrep): grouped, no automerge \u2014 checksums are re-verified in CI",
      "groupName": "pinned build tools",
      "matchManagers": ["regex"],
      "matchDatasources": ["github-releases", "pypi"],
      "automerge": false
    },
    {
      "description": "GitHub Actions: monthly, grouped",
      "groupName": "github-actions",
      "matchManagers": ["github-actions"],
      "extends": ["schedule:monthly"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest"]
    }
  ]
}
