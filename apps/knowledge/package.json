{
  "name": "knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild server/ingest.ts server/retrieval.ts --bundle --platform=node --format=esm --external:pg --outdir=dist",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.ts tests/ingest/*.test.ts tests/retrieval/*.test.ts",
    "eval": "node --experimental-strip-types eval/run-eval.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.1",
    "@types/node": "26.3.0",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "hono": "4.13.13",
    "typescript": "7.0.2"
  }
}
