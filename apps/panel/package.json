{
  "name": "panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts server/k8s.ts server/jobs.ts server/devtools.ts server/stats.ts --bundle --platform=node --format=esm --outdir=dist",
    "build": "npm run build:web && npm run build:server",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.ts",
    "dev": "vite",
    "lint": "cd ../.. && npx oxlint apps/panel",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hono/node-server": "2.1.8",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/table-core": "9.3.1",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
