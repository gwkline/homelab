{
  "name": "homelab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/panel",
    "apps/knowledge",
    "apps/knowledge-ingest",
    "apps/knowledge-retrieval",
    "apps/factory/collector",
    "apps/factory/github-app"
  ],
  "type": "module",
  "scripts": {
    "lint": "ultracite check && knip --workspace apps/panel",
    "lint:fix": "ultracite fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "knip": "6.40.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "ultracite": "7.10.7"
  }
}
