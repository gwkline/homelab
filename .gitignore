.DS_Store
node_modules/
dist/
tmp/
*.log
# Private security evidence and scanner caches are never published.
.audit-private/
# Credentials never belong in the repo.
kubeconfig*
*.kubeconfig
.env*
*.pem
*.key
# Email classifier training data and model artifacts are Gmail-derived:
# they live under models/email-classifier/ on the training machine only.
models/email-classifier/data/
models/email-classifier/artifacts/
models/email-classifier/venv/
models/email-classifier/src/__pycache__/

# Email classifier training data and model artifacts are Gmail-derived:
# they live under models/email-classifier/ on the training machine only.
models/email-classifier/data/
models/email-classifier/artifacts/
models/email-classifier/venv/
models/email-classifier/src/__pycache__/

# gavin-voice (models/gavin-voice): personal corpus + generated data never committed.
# Raw corpus, samples, eval outputs, venv and checkpoints live in
# $GAVIN_VOICE_LOCAL (~/git-dev/gavin-voice-local), outside the repo; these
# entries are defense-in-depth so a stray copy can never land in a commit.
models/gavin-voice/corpus/
models/gavin-voice/samples/
models/gavin-voice/venv/
models/gavin-voice/checkpoints/
models/gavin-voice/data/
models/gavin-voice/.judge_env
**/.judge_env

# Python bytecode never belongs in commits (v1 accidentally tracked five
# .pyc files; untracked in the v2 PR).
__pycache__/
*.pyc
